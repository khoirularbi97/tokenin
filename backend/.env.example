# Connection string Neon (pakai yang "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# String acak panjang untuk menandatangani JWT login
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Domain frontend yang boleh mengakses API, pisahkan dengan koma
CORS_ORIGIN=http://localhost:5173,https://tokenin.vercel.app

# Port lokal (Render mengisi PORT sendiri)
PORT=3000

# Aplikasi desktop dan HP Tokenin (app://tokenin, https://localhost, capacitor://localhost)
# selalu diizinkan. Isi false kalau hanya memakai versi web.
ALLOW_APP_ORIGINS=true
